# Copy to android/keystore.properties (git-ignored) and fill in. Never commit the
# real file or the keystore itself.
#
# Create a keystore once (keep it and its passwords safe; losing it means you can
# no longer publish updates under the same key):
#   keytool -genkeypair -v -keystore qflow-release.jks -alias qflow \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ folder (or an absolute path).
storeFile=qflow-release.jks
keyAlias=qflow
# Passwords can be left out here and supplied as environment variables instead:
#   QFLOW_KEYSTORE_PASSWORD and QFLOW_KEY_PASSWORD
storePassword=
keyPassword=
